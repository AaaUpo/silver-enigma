<Window x:Class="SurfaceTouchDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Surface Touch Deck"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#01000000"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False">
    <Grid>
        <Canvas x:Name="OverlayCanvas" Background="Transparent"/>

        <Border x:Name="HomeMenu"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#DD1D1D1D"
                BorderBrush="#444"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed"
                Padding="8">
            <StackPanel Width="Auto">
                <ItemsControl x:Name="LayoutItems" Margin="0,0,0,6"/>
                <Button x:Name="SelectStyleButton" Content="select style" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <Slider x:Name="OpacitySlider" Width="160" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="OpacityLabel" Margin="6,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Slider x:Name="SizeSlider" Width="160" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="SizeLabel" Margin="6,0,0,0" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="ExitButton" Content="exit" />
            </StackPanel>
        </Border>

        <Border x:Name="StyleMenu"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#E0202020"
                BorderBrush="#555"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed"
                Padding="8">
            <DockPanel LastChildFill="True">
                <ListBox x:Name="StyleList" MinWidth="220" Background="#222" Foreground="White" BorderThickness="0"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StyleCancel" Content="Cancel" Margin="0,0,8,0"/>
                    <Button x:Name="StyleConfirm" Content="Confirm"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel x:Name="EditBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,40">
            <Button x:Name="EditCancel" Content="Cancel" Margin="8"/>
            <Button x:Name="TrashButton" Content="🗑" Margin="8"/>
            <Button x:Name="AddButton" Content="+" Margin="8"/>
            <Button x:Name="EditSave" Content="Save" Margin="8"/>
        </DockPanel>
    </Grid>
</Window>
